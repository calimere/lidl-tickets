# Copier en .env (jamais commité) et remplir.

# OBLIGATOIRE. Clé qui chiffre les jetons Lidl en base. À SAUVEGARDER : sans elle, les
# jetons stockés deviennent illisibles (les utilisateurs devront reconnecter Lidl).
# Générer :  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LIDL_SECRET_KEY=

# Code d'invitation exigé à l'inscription (vide = inscription libre)
LIDL_REGISTRATION_CODE=

# Nom de domaine (profil Caddy)
DOMAIN=lidl-tickets.csk-prod.fr

# Cookie de session réservé à HTTPS ; mettre 0 seulement pour tester en http://localhost
LIDL_COOKIE_SECURE=1

# À 1 seulement si un antivirus/proxy inspecte le HTTPS (erreur « unable to get local
# issuer certificate »). Inutile sur le VPS.
LIDL_USE_SYSTEM_CA=0

# Port exposé sur 127.0.0.1 de l'hôte
LIDL_PORT=3006
